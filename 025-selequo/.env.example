# --- required in production
NODE_ENV=production
SELEQUO_SECRET=change-me-to-64-random-hex-chars-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DATABASE_URL=postgres://user:pass@host:5432/selequo
PUBLIC_URL=https://selequo.example.com
# --- optional
PORT=8787
TRUST_PROXY=1                    # number of reverse-proxy hops in front of the app (or proxy IPs); unset = do not trust X-Forwarded-For
HOST=0.0.0.0
SELEQUO_DATA_DIR=./data          # local file storage (use a persistent volume)
SIGNUP_ENABLED=true
MAX_UPLOAD_MB=20
MAX_FETCH_MB=5
FETCH_ALLOW_PORTS=80,443
PDF_RENDERER=chromium            # or none (users print the HTML brief to PDF)
# CHROMIUM_PATH=/path/to/chrome
# --- AI (default none = no external transmission)
AI_PROVIDER=none                 # none | anthropic
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
# --- development only (rejected in production)
# PGLITE_DIR=./data/pglite
# SELEQUO_FETCH_FIXTURES=fixtures/sample
